INTEGRATION_DB_HOST=
INTEGRATION_DB_PORT=5432
INTEGRATION_DB_NAME=postgres
INTEGRATION_DB_USER=
INTEGRATION_DB_PASSWORD=
JWT_ISSUER=https://${IDENTITY_HOST}/realms/platform
JWT_AUDIENCE=integration-service
JWT_PUBLIC_KEY_LOCATION=https://${IDENTITY_HOST}/realms/platform/protocol/openid-connect/certs
JAVA_OPTS=-Djavax.net.ssl.trustStore=/run/trust.jks -Djavax.net.ssl.trustStorePassword=changeit -Xms128m -Xmx512m
EDEN_TECH_USER=
EDEN_TECH_PASSWORD=
DISASTERS_READ_OAUTH_TOKEN_ENDPOINT=https://${IDENTITY_HOST}/realms/platform/protocol/openid-connect/token
DISASTERS_READ_OAUTH_CLIENT_ID=integration-disasters-read
DISASTERS_READ_OAUTH_CLIENT_SECRET=
DISASTERS_REPORT_OAUTH_TOKEN_ENDPOINT=https://${IDENTITY_HOST}/realms/platform/protocol/openid-connect/token
DISASTERS_REPORT_OAUTH_CLIENT_ID=integration-disasters
DISASTERS_REPORT_OAUTH_CLIENT_SECRET=
EDEN_ORG_CREATE_USER=
EDEN_ORG_CREATE_PASSWORD=
INTEGRATION_DB_POOL_MIN=
INTEGRATION_DB_POOL_WAIT_MS=

DAMAGE_DB_HOST=
DAMAGE_DB_PORT=5432
DAMAGE_DB_NAME=postgres
DAMAGE_DB_USER=
DAMAGE_DB_PASSWORD=
JWT_ISSUER=https://${IDENTITY_HOST}/realms/platform
JWT_AUDIENCE=damage-assessment-api
JWT_PUBLIC_KEY_LOCATION=https://${IDENTITY_HOST}/realms/platform/protocol/openid-connect/certs
DISASTERS_OAUTH_TOKEN_ENDPOINT=https://${IDENTITY_HOST}/realms/platform/protocol/openid-connect/token
DISASTERS_OAUTH_CLIENT_ID=assessment-disasters
DISASTERS_OAUTH_CLIENT_SECRET=
JAVA_OPTS=-Djavax.net.ssl.trustStore=/run/trust.jks -Djavax.net.ssl.trustStorePassword=changeit -Xms128m -Xmx512m
EVIDENCE_STORAGE_EMAIL=
EVIDENCE_STORAGE_PASSWORD=
EVIDENCE_STORAGE_PUBLISHABLE_KEY=
EVIDENCE_STORAGE_BUCKET=damage-evidence
